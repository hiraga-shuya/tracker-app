generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // ログインするためのユーザー情報データ
  id         String       @id //idの自動生成はcookie側で行う
  name       String
  image      String?
  created_at DateTime     @default(now()) //@default(now())=レコード作成時の日時を返す
  habits     Habit_Task[] //Habit_Taskテーブルの値を配列形式で返す
  accessDays User_Access_Day[] //アプリを開いた日の記録（起動日数の実績判定用）
  reminders  Reminder[] //ユーザーが作った通知リマインダー
  pushSubscriptions Push_Subscription[] //Web Push の購読情報（端末ごと）
}

model User_Access_Day {
  // アプリを開いた日を1日1件で記録するデータ（起動日数の実績判定用）
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime //その日の0時（JST）を表す日時。習慣の記録データと同じ形式で持つ

  @@unique([userId, date]) //同じ日に2件は登録できない（開いた日は1日として数える）
  @@index([userId])
}

model Habit_Task {
  // ユーザーごとに登録できる習慣タスクのデータ
  id         String         @id @default(cuid()) //ユニークなIDを自動で生成
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  //Habit_Task.userId と User.id を紐づけ。User.idに存在しない値が入った場合エラーを返す。
  name       String
  icon_type  String         @default("book") //カテゴリアイコン
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt //同一レコード内で何か更新されたタイミングでその時のサーバー日時が入る
  deleted_at DateTime? // 削除されたタイミングでその時のサーバー日時が入る（？をつけることでnull許可）
  is_active  Boolean        @default(true) //Boolean=トグル。@default(true)にしているので、ユーザー画面側から特に値が返ってこなければtrueにする
  records    Habit_Record[] //Habit_Recordテーブルの値を配列形式で返す

  @@index([userId]) //頻繁にクエリで呼び出すデータなのでインデックスさせる
}

model Habit_Record {
  // 習慣タスクの達成記録データ（一日単位で記録）
  id            String     @id @default(cuid())
  habit_task_id String
  date          DateTime   @default(now()) //同一の習慣タスクは1日1回まで、の判断用のデータ
  created_at    DateTime   @default(now()) //レコード作成時の日時を返す。機能上は不要ですが、何かあったとき用の記録として必要。
  habit_task    Habit_Task @relation(fields: [habit_task_id], references: [id]) // 「Habit_Record.habit_task_id」と「Habit_Task.id」を紐づけ。Habit_Task.idに存在しない値が入った場合エラーを返す。

  @@unique([habit_task_id, date]) // 「習慣タスクID / 日付」が同一のものは登録できない。（一日に2回、同じタスクを達成することはできない制約）
  @@index([habit_task_id]) //頻繁にクエリで呼び出すデータなのでインデックスさせる
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
}

model Reminder {
  // ユーザーが自由に作れる通知リマインダー。
  // 習慣タスクとは紐づけない、独立した仕様（時刻と曜日だけで通知する）。
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  title      String // 通知のタイトル
  body       String? // 通知の本文（任意）
  hour       Int // 通知する時（0〜23、日本時間）
  minute     Int // 通知する分（0〜59）
  daysOfWeek Int[] // 通知する曜日（0=日曜〜6=土曜）。毎日の場合は全曜日を入れる
  is_active  Boolean   @default(true) // 有効・無効の切り替え
  lastSentAt DateTime? // 最後に送信した「予定日時」。二重送信の防止に使う
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([userId])
}

model Push_Subscription {
  // Web Push の購読情報（端末・ブラウザごとに1件）
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  endpoint   String   @unique // 購読の宛先URL。端末の識別に使う
  p256dh     String // 暗号化用の公開鍵
  auth       String // 暗号化用の認証シークレット
  created_at DateTime @default(now())

  @@index([userId])
}
